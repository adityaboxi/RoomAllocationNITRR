
# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Your database name is: roomallocation
MONGODB_URI=mongodb://localhost:27017/roomallocation

# If you want to use a different database name, change it here:
# Example: MONGODB_URI=mongodb://localhost:27017/your_database_name

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=nitrr_room_allocation_super_secret_key_2024_secure
JWT_EXPIRE=7d

# ============================================
# EMAIL CONFIGURATION (Gmail)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-digit-app-password
EMAIL_FROM=noreply@nitrr.ac.in

# ============================================
# EMAIL DOMAIN RESTRICTION
# ============================================
ALLOWED_EMAIL_DOMAIN=nitrr.ac.in

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=1000
RATE_LIMIT_MAX=4

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=10

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
