# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/roomallocation

# JWT Authentication
JWT_SECRET=nitrr_room_allocation_secret_key_2024_secure
JWT_EXPIRE=7d

# Email Configuration (NITRR Email Only)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@nitrr.ac.in

# Allowed Email Domain
ALLOWED_EMAIL_DOMAIN=nitrr.ac.in

# Rate Limiting
RATE_LIMIT_WINDOW=1000
RATE_LIMIT_MAX=4

# Security
BCRYPT_ROUNDS=10