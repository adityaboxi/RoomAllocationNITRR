# =================================================================
# 🌐 SERVER & NETWORK CONFIGURATION
# =================================================================
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# =================================================================
# 🗄️ DATABASE CONFIGURATION (MongoDB)
# =================================================================
MONGODB_URI=mongodb://localhost:27017/roomallocation
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=10

# =================================================================
# 🔐 AUTHENTICATION & JWT SECURITY
# =================================================================
JWT_SECRET=nitrr_room_allocation_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Allowed email domains (comma-separated). Supports exact domain or wildcards.
ALLOWED_EMAIL_DOMAINS=gmail.com,nitrr.ac.in,*.nitrr.ac.in

# =================================================================
# 📧 EMAIL & SMTP SERVICE CONFIGURATION
# =================================================================
# Set to 'true' to log emails/OTPs to the console only without sending via SMTP
ENABLE_EMAIL_LOGGING_ONLY=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_institution_email@gmail.com
SMTP_PASS=your_app_specific_password_here
FROM_EMAIL=noreply@nitrr.ac.in
FROM_NAME="NIT Raipur Room Allocation Portal"

# =================================================================
# 🏫 ROOM RESERVATION & SCHEDULING BUSINESS RULES
# =================================================================
# Maximum number of days a faculty member can book in advance (e.g. 7 days)
MAX_ADVANCE_BOOKING_DAYS=7

# Minimum duration for an ad-hoc reservation slot in minutes (e.g. 30 min)
MIN_BOOKING_DURATION_MINUTES=30

# Duration for temporary checkout room locks in seconds (e.g. 300 = 5 min)
TEMPORARY_LOCK_EXPIRY_SECONDS=300

# Whether bookings are allowed on Sundays (true / false)
ALLOW_SUNDAY_BOOKINGS=false

# =================================================================
# 🧹 DATABASE PRUNING CRON CONFIGURATION
# =================================================================
# Interval in hours between automated database maintenance runs (e.g. 24)
CLEANUP_CRON_INTERVAL_HOURS=24

# Purge cancelled bookings older than X days (if not linked to recent reviews)
PRUNE_CANCELLED_BOOKINGS_DAYS=7

# Purge read notifications older than X days
PRUNE_READ_NOTIFICATIONS_DAYS=7

# Purge unread notifications older than X days
PRUNE_UNREAD_NOTIFICATIONS_DAYS=30

# Purge verified/expired OTPs older than X hours
PRUNE_OTP_HOURS=24