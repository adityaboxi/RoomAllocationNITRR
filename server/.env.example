# =====================
# SERVER CONFIGURATION
# =====================
PORT=3000
NODE_ENV=development

# Frontend origin (for CORS)
CORS_ORIGIN=http://localhost:5173

# =====================
# DATABASE
# =====================
MONGODB_URI=mongodb://localhost:27017/roomallocation


# =====================
# JWT AUTHENTICATION
# =====================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# =====================
# EMAIL (SMTP)
# =====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=your_email@gmail.com
EMAIL_FROM=NITRR Room Allocation <your_email@gmail.com>

# =====================
# EMAIL DOMAINS (comma separated)
# =====================
ALLOWED_EMAIL_DOMAINS=cse.nitrr.ac.in,gmail.com
TEST_ALLOWED_DOMAINS=cse.nitrr.ac.in,gmail.com

# =====================
# OTP CONFIGURATION
# =====================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# =====================
# SECURITY & FEATURES
# =====================
RATE_LIMIT_MAX=4
BCRYPT_SALT_ROUNDS=10
REQUIRE_EMAIL_VERIFICATION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_HOD_APPROVAL=true
ENABLE_OTP_VERIFICATION=false
DEBUG_EMAIL=true
LOG_LEVEL=INFO