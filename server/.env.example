# =================================================================
# 🔴 SECTION 1: MUST CHANGE IN PRODUCTION (CRITICAL)
# =================================================================
# 1. Server Environment & Deployment URLs
NODE_ENV=production
PORT=3000
CLIENT_URL=https://portal.nitrr.ac.in
CORS_ORIGIN=https://portal.nitrr.ac.in

# 2. Production Database Connection String (MongoDB Atlas / Self-Hosted)
MONGODB_URI=mongodb+srv://admin_user:YourStrongPassword123@cluster0.abcde.mongodb.net/roomallocation?retryWrites=true&w=majority

# 3. Cryptographic JWT Security Key (Generate a random 64+ char string)
JWT_SECRET=replace_this_with_a_super_secret_cryptographic_random_string_64_chars

# 4. Institutional SMTP Mail Service Credentials
ENABLE_EMAIL_LOGGING_ONLY=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin.roombooking@nitrr.ac.in
SMTP_PASS=abcd1234efgh5678
FROM_NAME="NIT Raipur Room Allocation"
FROM_EMAIL=admin.roombooking@nitrr.ac.in



# =================================================================
# 🟢 SECTION 2: DEFAULT / OPTIONAL (MAY NOT NEED MODIFICATION)
# =================================================================
# 1. General Network & Timezone
TIMEZONE=Asia/Kolkata
BODY_LIMIT=10mb

# 2. Database Connection Pooling & Timeouts
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=10
DB_TIMEOUT_MS=5000

# 3. Authentication & Password Security
JWT_EXPIRES_IN=7d
JWT_EXPIRE=7d
BCRYPT_SALT_ROUNDS=10

# 4. Academic Departments & Branches
DEPARTMENTS="Computer Science & Engineering,Information Technology,Electronics & Communication,Electrical Engineering,Mechanical Engineering,Civil Engineering,Chemical Engineering,Biotechnology,Metallurgical & Materials,Mining Engineering"

# 5. Email Transport Pool Limits
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# 6. Business Logic & Booking Timers
OTP_EXPIRY_MINUTES=5
LOCK_EXPIRY_SECONDS=300
MAX_BOOKING_DAYS_ADVANCE=7
MAX_FILE_UPLOAD_MB=5

# 7. Database Maintenance & Auto-Pruning Schedule
CLEANUP_CRON_INTERVAL_HOURS=24
PRUNE_CANCELLED_BOOKINGS_DAYS=7
PRUNE_READ_NOTIFICATIONS_DAYS=7
PRUNE_UNREAD_NOTIFICATIONS_DAYS=30
PRUNE_OTP_HOURS=24

# 8. Real-Time Socket.IO Heartbeats
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000