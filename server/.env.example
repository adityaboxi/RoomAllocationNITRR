# =================================================================
# 🌐 SERVER & NETWORK CONFIGURATION
# =================================================================
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# =================================================================
# 🗄️ DATABASE CONFIGURATION (MongoDB)
# =================================================================
MONGODB_URI=mongodb://localhost:27017/roomallocation
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=10

# =================================================================
# 🔐 AUTHENTICATION & JWT SECURITY
# =================================================================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d
JWT_EXPIRE=7d
BCRYPT_SALT_ROUNDS=10

# Dynamic Departments & Branches (Comma-separated)
DEPARTMENTS="Computer Science & Engineering,Information Technology,Electronics & Communication,Electrical Engineering,Mechanical Engineering,Civil Engineering,Chemical Engineering,Biotechnology,Metallurgical & Materials,Mining Engineering"

# OTP Verification Rules
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
REQUIRE_EMAIL_VERIFICATION=true
ENABLE_OTP_VERIFICATION=true

# Allowed Email Domains (Institutional & Testing)
ALLOWED_EMAIL_DOMAINS=cse.nitrr.ac.in,nitrr.ac.in,gmail.com,*.nitrr.ac.in
TEST_ALLOWED_DOMAINS=cse.nitrr.ac.in,gmail.com

# =================================================================
# 📧 REAL SMTP EMAIL SERVICE (Nodemailer Configuration)
# =================================================================
ENABLE_EMAIL_LOGGING_ONLY=false
ENABLE_EMAIL_NOTIFICATIONS=true
DEBUG_EMAIL=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME="NITRR Room Allocation"
EMAIL_FROM="NITRR Room Allocation <your_email@gmail.com>"

# Fallback email aliases for Nodemailer
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password

# =================================================================
# 🏫 ROOM RESERVATION & SCHEDULING BUSINESS RULES
# =================================================================
# Maximum days in advance a faculty member can book
MAX_ADVANCE_BOOKING_DAYS=7

# Minimum booking duration in minutes
MIN_BOOKING_DURATION_MINUTES=30

# Duration for temporary checkout room locks in seconds (300s = 5 min)
TEMPORARY_LOCK_EXPIRY_SECONDS=300

# Whether bookings are allowed on Sundays
ALLOW_SUNDAY_BOOKINGS=false

# Enable HOD Approval Workflow
ENABLE_HOD_APPROVAL=true

# =================================================================
# 🧹 DATABASE PRUNING & MAINTENANCE CRON
# =================================================================
# Interval in hours between automated cleanup passes (24h)
CLEANUP_CRON_INTERVAL_HOURS=24

# Purge cancelled bookings older than X days (preserving reviewed/active)
PRUNE_CANCELLED_BOOKINGS_DAYS=7

# Purge read notifications older than X days
PRUNE_READ_NOTIFICATIONS_DAYS=7

# Purge stale unread notifications older than X days
PRUNE_UNREAD_NOTIFICATIONS_DAYS=30

# Purge verified/expired OTPs older than X hours
PRUNE_OTP_HOURS=24

# Logging Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO