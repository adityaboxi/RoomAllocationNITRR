# =================================================================
# 🔴 SECTION 1: CORE SERVER & DATABASE CONFIGURATION
# =================================================================
# 1. Server Environment & Port
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# 2. Database Connection (MongoDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/roomallocation

# 3. Cryptographic JWT Secret Key
JWT_SECRET=nitrr_production_jwt_secret_random_secure_key_2026_x89!

# 4. Institutional SMTP Mail Service Credentials
ENABLE_EMAIL_LOGGING_ONLY=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=krishnab3@gmail.com
SMTP_PASS=ozqcodyhq
FROM_NAME="NIT Raipur Room Allocation"
FROM_EMAIL=krishnab83@gmail.com


# =================================================================
# 🟢 SECTION 2: SYSTEM OPTIMIZATION & BUSINESS LOGIC
# =================================================================
# 1. General Network & Timezone
TIMEZONE=Asia/Kolkata
BODY_LIMIT=10mb

# 2. Database Connection Pooling & Timeouts
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=10
DB_TIMEOUT_MS=5000

# 3. Authentication & Password Security
JWT_EXPIRES_IN=7d
JWT_EXPIRE=7d
BCRYPT_SALT_ROUNDS=10

# 4. Academic Departments & Branches (Dynamic Multi-Branch Support)
DEPARTMENTS="Computer Science & Engineering,Information Technology,Electronics & Communication,Electrical Engineering,Mechanical Engineering,Civil Engineering,Chemical Engineering,Biotechnology,Metallurgical & Materials,Mining Engineering"

# 5. Email Transport Pool Limits
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# 6. Business Logic & Booking Timers
OTP_EXPIRY_MINUTES=5
LOCK_EXPIRY_SECONDS=300
MAX_BOOKING_DAYS_ADVANCE=7
MAX_FILE_UPLOAD_MB=5

# 7. Database Maintenance & Auto-Pruning Schedule
CLEANUP_CRON_INTERVAL_HOURS=24
PRUNE_COMPLETED_BOOKINGS_DAYS=90
PRUNE_REVIEWS_DAYS=90
PRUNE_CANCELLED_BOOKINGS_DAYS=7
PRUNE_READ_NOTIFICATIONS_DAYS=7
PRUNE_UNREAD_NOTIFICATIONS_DAYS=30
PRUNE_OTP_HOURS=24

# 8. Real-Time Socket.IO Heartbeats
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000

# =================================================================
# 🟣 SECTION 3: SYSTEM ADMINISTRATOR CREDENTIALS
# =================================================================
ADMIN_EMAIL=adityabo@gmail.com
ADMIN_PASSWORD=adminsecret23
