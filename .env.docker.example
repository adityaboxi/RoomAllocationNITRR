# ==============================================================================
# NIT Raipur Room Allocation System - Docker Environment Variables
# Copy this file to .env before running: docker compose up --build
# ==============================================================================

# Port to expose on host machine (Both frontend SPA and backend API run on this port)
PORT=3000

# Node Environment
NODE_ENV=production

# ==============================================================================
# Database Connections
# For External Cloud Database (e.g. MongoDB Atlas):
# Paste your Atlas connection string below.
# ==============================================================================
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roomallocation?retryWrites=true&w=majority
# REPORT_MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roomallocation_reports?retryWrites=true&w=majority

# (Leave commented out to use the built-in local Docker mongo service)
# MONGODB_URI=mongodb://mongo:27017/roomallocation
# REPORT_MONGODB_URI=mongodb://mongo:27017/roomallocation_reports

# Security & Secrets
JWT_SECRET=nitrr_production_jwt_secret_random_secure_key_2026_x89!
JWT_EXPIRES_IN=7d

# CORS (Frontend & Backend run on same port, wildcard or domain allowed)
CORS_ORIGIN=*
CLIENT_URL=http://localhost:3000

# Super Admin Account
ADMIN_EMAIL=admin@nitrr.ac.in
ADMIN_PASSWORD=adminsecret123

# Email Notifications (Set ENABLE_EMAIL_LOGGING_ONLY=false when providing SMTP credentials)
ENABLE_EMAIL_LOGGING_ONLY=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME="NIT Raipur Room Allocation"
FROM_EMAIL=admin@nitrr.ac.in

# Business Rules
MAX_BOOKING_DAYS_ADVANCE=14
LOCK_EXPIRY_SECONDS=300
OTP_EXPIRY_MINUTES=5

# Rate Limits (Requests per window)
AUTH_RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1000
GLOBAL_RATE_LIMIT_WINDOW_MS=900000

# Dedicated 30-Day Report Database Sync Engine
REPORT_SYNC_INTERVAL_HOURS=24
REPORT_ARCHIVE_AGE_DAYS=30
