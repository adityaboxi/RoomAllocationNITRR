cd client

cat > .env << 'EOF'
# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL
VITE_API_URL=http://localhost:3000/api

# WebSocket URL (for real-time features)
VITE_WS_URL=http://localhost:3000

# ============================================
# APP CONFIGURATION
# ============================================
# Application name
VITE_APP_NAME=Room Allocation System - NIT Raipur

# Application version
VITE_APP_VERSION=1.0.0

# Allowed email domain (only these emails can register/login)
VITE_ALLOWED_DOMAIN=nitrr.ac.in

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable email notifications
VITE_ENABLE_EMAIL_NOTIFICATIONS=true

# Maximum requests per second (display only)
VITE_MAX_REQUESTS_PER_SECOND=4

# ============================================
# OTP CONFIGURATION
# ============================================
# OTP length (digits)
VITE_OTP_LENGTH=6

# OTP expiry time in minutes
VITE_OTP_EXPIRY_MINUTES=10

# ============================================
# ENVIRONMENT
# ============================================
# Current environment (development/production)
VITE_ENV=development

# Enable debug mode
VITE_DEBUG=true
EOF