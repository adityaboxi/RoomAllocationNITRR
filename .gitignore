cd /Users/adityaboxi/Desktop/WebDev/project/RoomAllocationNITRR

# Write the complete unified .gitignore with ios_app ignored
cat << 'EOF' > .gitignore
# =================================================================
# 🔐 1. ENVIRONMENT VARIABLES & SECRETS (NEVER COMMIT)
# =================================================================
.env
.env.*
server/.env
server/.env.*
client/.env
client/.env.*
RoomAllocationNITRR_ios/.env
RoomAllocationNITRR_ios/.env.*
!.env.example
!server/.env.example
!client/.env.example
!RoomAllocationNITRR_ios/.env.example

# =================================================================
# 📦 2. DEPENDENCIES & PACKAGE CACHES
# =================================================================
node_modules/
server/node_modules/
client/node_modules/
RoomAllocationNITRR_ios/node_modules/

# =================================================================
# 🔒 3. LOCK FILES
# =================================================================
package-lock.json
server/package-lock.json
client/package-lock.json
RoomAllocationNITRR_ios/package-lock.json
yarn.lock
server/yarn.lock
client/yarn.lock
RoomAllocationNITRR_ios/yarn.lock
pnpm-lock.yaml
server/pnpm-lock.yaml
client/pnpm-lock.yaml
RoomAllocationNITRR_ios/pnpm-lock.yaml

# =================================================================
# 🏗️ 4. WEB & REACT BUILD OUTPUTS
# =================================================================
dist/
build/
server/dist/
server/build/
client/dist/
client/build/
RoomAllocationNITRR_ios/dist/
.vite/
.cache/
.temp/
.tmp/
*.tmp
*.temp

# =================================================================
# 📱 5. IOS & XCODE GENERATED NATIVE FOLDERS
# =================================================================
# Ignore the entire iOS app folder
RoomAllocationNITRR_ios/
ios_app/

# =================================================================
# 📋 6. LOGS & RUNTIME DATA
# =================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server/logs/
client/logs/
RoomAllocationNITRR_ios/logs/

# =================================================================
# 🍎 7. OS & IDE SYSTEM FILES
# =================================================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.iws
*.ipr

# =================================================================
# 🔑 8. CERTIFICATES & KEYS
# =================================================================
*.pem
*.key
*.crt
*.p12
*.pfx
*.p8
credentials.json
service-account.json
EOF

# Remove the iOS folder from Git tracking (keep locally)
git rm -r --cached RoomAllocationNITRR_ios/ 2>/dev/null || true
git rm -r --cached ios_app/ 2>/dev/null || true

# Refresh git index
git add .gitignore
git commit -m "Ignore iOS app folders"
git push


ios_app/